# Team dev Postgres (via ocha-stratus). Read creds for exports, write creds for refresh.
DSCI_AZ_DB_DEV_HOST=
DSCI_AZ_DB_DEV_UID=
DSCI_AZ_DB_DEV_PW=
DSCI_AZ_DB_DEV_UID_WRITE=
DSCI_AZ_DB_DEV_PW_WRITE=
PGSSLMODE=require

# HDX HAPI app identifier: base64 of "<app-name>:<email>" (no registration needed)
HAPI_APP_IDENTIFIER=

# IPC API key (free, per-user, from the IPC Global Support Unit). The source
# of the population history and of the analyses table. Without it the refresh
# reads the HDX files instead, which hold 2021 onward only.
IPC_AUTH=
